# Copiá este archivo a .env y completá con los datos de tu proyecto Supabase
# (Dashboard → Settings → API Keys). SOLO la publishable/anon key va acá,
# nunca la secret key.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Clave pública VAPID para las notificaciones push. Es pública a propósito
# (viaja al navegador). La privada NUNCA va acá: se carga como secret en
# Supabase con `supabase secrets set VAPID_PRIVATE_KEY=...`.
# Para generar un par nuevo: node scripts/generate-vapid-keys.mjs
VITE_VAPID_PUBLIC_KEY=BFxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
